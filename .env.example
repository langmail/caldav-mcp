# CalDAV Server Configuration
CALDAV_BASE_URL=https://your-caldav-server.com/dav
CALDAV_USERNAME=your-username
CALDAV_PASSWORD=your-password

# Optional: several accounts in one server. When set, the three variables
# above are ignored and each named account needs its own three, with the
# name in upper case. See "Several accounts" in README.md.
# CALDAV_ACCOUNTS=personal,family
# CALDAV_PERSONAL_BASE_URL=https://your-caldav-server.com/dav
# CALDAV_PERSONAL_USERNAME=your-username
# CALDAV_PERSONAL_PASSWORD=your-password
# CALDAV_FAMILY_BASE_URL=https://other-caldav-server.example/dav
# CALDAV_FAMILY_USERNAME=other-username
# CALDAV_FAMILY_PASSWORD=other-password

# Optional: only used with --http (Streamable HTTP transport)
# MCP_HOST=127.0.0.1
# MCP_PORT=3000
# Bearer token for POST /mcp; required when MCP_HOST is not a loopback address.
# MCP_AUTH_TOKEN=your-shared-secret

# Note: Copy this file to .env and fill in your actual credentials
# Always use HTTPS for CALDAV_BASE_URL
